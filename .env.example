# Copy this file to .env and fill in real values. .env is git-ignored.
# Never put real keys in this file — it is committed.
# Every key below has a free tier. Leave any blank to skip that provider.

# Local models (free, no key) — default Ollama address
OLLAMA_HOST=http://localhost:11434

# Gemini API free tier — https://aistudio.google.com
GEMINI_API_KEY=

# GitHub Models free tier (GPT and others) — a GitHub token with "models" access
GITHUB_TOKEN=

# OpenRouter free models (":free" suffix) — https://openrouter.ai
OPENROUTER_API_KEY=

# Claude is used through Claude Code (`claude -p`) on a Claude Pro plan,
# so no API key is needed. The paid Claude API is optional and not required:
# ANTHROPIC_API_KEY=
